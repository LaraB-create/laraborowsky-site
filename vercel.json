{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "lavalou.fun" }],
      "destination": "https://laraborowsky.com/lavalou/:path*",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.lavalou.fun" }],
      "destination": "https://laraborowsky.com/lavalou/:path*",
      "permanent": false
    }
  ]
}
