{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?lavalou\\.fun"
        }
      ],
      "destination": "https://www.laraborowsky.com/lavalou",
      "permanent": false
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?lavalou\\.fun"
        }
      ],
      "destination": "https://www.laraborowsky.com/lavalou/:path+",
      "permanent": false
    },
    {
      "source": "/about",
      "destination": "/",
      "permanent": false
    }
  ]
}